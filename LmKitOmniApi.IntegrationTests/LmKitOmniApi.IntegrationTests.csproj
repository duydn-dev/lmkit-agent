<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Live-engine integration tests. NOT part of the FAST suite: the fast suite is run as
    `dotnet test LmKitOmniApi.Tests/LmKitOmniApi.Tests.csproj`, which never touches this
    project. Run these explicitly with:
        dotnet test LmKitOmniApi.IntegrationTests
    Every test is [SkippableFact]: without Docker the container fails to start, the fixture
    records the reason, and the test SKIPS. That skip is opt-in — set LMKIT_REQUIRE_CONTAINERS=1
    (CI does) and a container that will not start FAILS instead. See README.md.

    CI runs this project in its own `integration` job; it is no longer build-only-on-a-laptop
    code. That matters for the vulnerability gate too: the gate now scans the whole solution,
    so a CVE reaching only this project can no longer hide behind "CI never builds it".
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.MySql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.MongoDb" Version="4.15.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings in the DB providers under test AND, transitively, Npgsql / MySqlConnector /
         Microsoft.Data.SqlClient / MongoDB.Driver used to seed the containers. -->
    <ProjectReference Include="..\LmKitOmniApi\LmKitOmniApi.csproj" />
  </ItemGroup>

</Project>
