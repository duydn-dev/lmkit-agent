    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="LM-Kit.NET.Backend.Cuda13.Windows" Version="2026.8.2" />
  </ItemGroup>

  <!-- Generated legacy surfaces contain placeholder LMFunction methods that
       throw NotImplementedException. Do not publish them as callable tools. -->
  <ItemGroup>
    <Compile Remove="Infrastructure\Tools\Office\**\*.cs" />
    <Compile Remove="Infrastructure\Tools\Images\**\*.cs" />
    <Compile Remove="Infrastructure\Tools\Pdf\**\*.cs" />
    <Compile Remove="Infrastructure\AI\IGraphKnowledgeService.cs" />
  </ItemGroup>

</Project>
