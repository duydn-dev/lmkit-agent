[TEMPLATE]
# ==========================================
# CẤU HÌNH BẢO MẬT HỆ THỐNG
# Sao chép file này thành .env và điền giá trị thật
# ==========================================

# 1. Cơ sở dữ liệu (PostgreSQL)
POSTGRES_PASSWORD=your_super_secret_postgres_password_here

# 2. Redis (cache, revocation state and distributed AI rate limiting)
# Host:port only — the API container automatically appends the password below as
# "<host:port>,password=${REDIS_PASSWORD}" when it builds the connection string.
REDIS_CONNECTION_STRING=redis:6379
# Password protecting Redis (holds the JWT blacklist + distributed rate-limit state).
# Required by docker-compose. Use a strong value and do NOT include a comma.
REDIS_PASSWORD=your_super_secret_redis_password_here

# 3. JWT Security (Bảo mật API)
JWT_SECRET_KEY=your_super_secret_jwt_key_must_be_at_least_32_characters_long

# 3b. Optional LM-Kit commercial license
LMKIT_LICENSE_KEY=
# Production should set all three values below to true. They remain false in the
# local example so the infrastructure can be tested without downloading a model.
LMKIT_REQUIRE_LICENSE=false
AI_WARMUP_CHAT_MODEL=false
AI_REQUIRE_CHAT_MODEL_READY=false

# 3c. LiveKit credentials (must match the LiveKit server configuration)
# Local-only values for: docker compose --profile development up
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# 3d. Optional OpenTelemetry collector
OTEL_EXPORTER_OTLP_ENDPOINT=

# Set true only when the browser reaches the application over HTTPS.
AUTH_COOKIE_SECURE=false

# 3e. Host ports, images and tags for the containers. Leave empty for defaults:
# API port 5032, client port 80, Postgres 5432, Qdrant 6333/6334, Redis 6379;
# images duydndev/lmkit-api, duydndev/lmkit-client with tag "latest".
# The full-stack e2e mode overrides all host ports per-run (see the mode-3
# header comment in docker-compose.yml). Production rollouts should pin
# API_IMAGE_TAG / CLIENT_IMAGE_TAG to the git-sha tag published by the
# build-push scripts instead of "latest".
API_HOST_PORT=
CLIENT_HOST_PORT=
POSTGRES_HOST_PORT=
QDRANT_HTTP_HOST_PORT=
QDRANT_GRPC_HOST_PORT=
REDIS_HOST_PORT=
API_IMAGE=
CLIENT_IMAGE=
API_IMAGE_TAG=
CLIENT_IMAGE_TAG=

# 3f. GPUs handed to the API container. Empty or "all" = every GPU on the host
# (requires nvidia-container-toolkit). Set to 0 on a CPU-only host, otherwise the
# container refuses to start with "could not select device driver ... [[gpu]]";
# LM-Kit then falls back to CPU. The full-stack e2e mode sets 0 for itself.
API_GPU_COUNT=

# 4. Frontend client origin (CORS)
# Must match the ORIGIN of the client app: the nginx client runs on
# CLIENT_HOST_PORT (default 80), so the origin is http://localhost (port 80
# never appears in an origin). If you change CLIENT_HOST_PORT (e.g. 3000),
# set CORS_ORIGIN=http://localhost:3000. Browser traffic goes through the
# nginx /api proxy (same-origin), so CORS only bites when calling the API
# directly (http://localhost:5032) from a different origin (e.g. Vite 5173).
CORS_ORIGIN=http://localhost

# 4b. SearXNG self-hosted metasearch (docker compose up searxng).
# Leave EMPTY for the containerized prod stack (defaults to
# http://searxng:8080 internally). For direct `dotnet run` debugging on the
# host, export WebSearch__Searx__BaseUrl=http://localhost:8888 in your shell
# instead of setting it here.
SEARXNG_BASE_URL=

# =============================================================================
# 5. Deployment (LM-Kit.NET Linux backends)
# =============================================================================
# ONE command for every host. The compose `api` service declares an NVIDIA GPU
# reservation whose count is API_GPU_COUNT (section 3f); LM-Kit uses CUDA when a
# GPU is present and falls back to CPU when it is not:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
# Build both images first if they are not on Docker Hub yet:
#   scripts\build-push.bat --no-push     (Windows)   /   ./scripts/build-push.sh --no-push
# The build scripts pick a Dockerfile TARGET, not a base image (API_BASE_IMAGE is
# read by neither script — only build-push.bat's help text still mentions it):
#   final-slim (default) — ubuntu:22.04 + the CUDA runtime libraries copied in
#   final                — the full nvidia/cuda base (~4.4GB)
API_TARGET=

# =============================================================================
# 6. Quick trial: models + first admin account
# =============================================================================
# Chat / vision / embedding / reranker model ids (server-controlled).
# All defaults resolve to LOCAL files in /app/AIModels through the
# AiModels:Models registry in appsettings.json (keys: bonsai, glm-ocr,
# bge-m3) - no download, no internet needed. bge-m3 serves BOTH the
# embedding and the reranker slots (BGE-M3 cross-encoder rerank).
# Other options: LM-Kit catalog ids (e.g. qwen3.5:2b, paddleocr-vl-1.6:0.9b,
# gemma3:270m, bge-reranker-v2-m3) resolve automatically; HuggingFace .gguf
# URLs auto-download to /app/Models on first use.
#   AI_DEFAULT_CHAT=bonsai
#   AI_DEFAULT_VISION=glm-ocr
#   AI_DEFAULT_EMBEDDING=bge-m3
#   AI_DEFAULT_RERANKER=bge-m3
# Warm the chat model at startup and gate /health/ready on it (recommended for
# dedicated AI servers so the first chat does not pay the download+load cost):
AI_WARMUP_CHAT_MODEL=false
AI_REQUIRE_CHAT_MODEL_READY=false
# First-run bootstrap admin (for a quick trial ONLY):
#   1) set BOOTSTRAP_ADMIN_ENABLED=true + email/password, `docker compose up`,
#   2) log in, 3) remove these lines and restart. No default admin exists.
# BOOTSTRAP_ADMIN_EMAIL accepts a plain username (e.g. "admin") as well as
# an email address - login matches the stored value case-insensitively.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# =============================================================================
# 7. Local AI models (bind mount)
# =============================================================================
# The API resolves LOCAL models from /app/AIModels inside the container
# (AiModels:ModelsDirectory=AIModels), which is bind-mounted from the host:
#   AI_MODELS_HOST_DIR=./LmKitOmniApi/AIModels   (default, same as the repo)
# Copy your .gguf / .lmk model files there, e.g.:
#   cp ~/models/Qwen3.5-2B-Q4_K_M.gguf LmKitOmniApi/AIModels/
#   scp -r models/ user@server:/opt/lmkit/AIModels   (then set AI_MODELS_HOST_DIR)
# Reference them without any download:
#   1) Register a named entry in AiModels:Models (see appsettings.json) with
#      "Path": "<subdir>/<file>.gguf" relative to /app/AIModels, then set
#      AiModels__DefaultChat=<key>;
#   2) or point the slot directly at an in-container absolute path, e.g.
#      AI_DEFAULT_CHAT=/app/AIModels/Qwen3.5-2B-Q4_K_M.gguf
AI_MODELS_HOST_DIR=
# Remote-model download cache mounted at /app/Models. Default is the `models`
# named volume; set a host directory to bind-mount instead:
#   AI_MODELS_CACHE_HOST_DIR=/opt/lmkit/model-cache
AI_MODELS_CACHE_HOST_DIR=
