# ==========================================
# CẤU HÌNH BẢO MẬT HỆ THỐNG
# Sao chép file này thành .env và điền giá trị thật
# ==========================================

# 1. Cơ sở dữ liệu (PostgreSQL)
POSTGRES_PASSWORD=your_super_secret_postgres_password_here

# 2. Redis (Cache & SignalR Backplane)
REDIS_CONNECTION_STRING=redis:6379

# 3. JWT Security (Bảo mật API)
JWT_SECRET_KEY=your_super_secret_jwt_key_must_be_at_least_32_characters_long

# 3b. Optional LM-Kit commercial license
LMKIT_LICENSE_KEY=

# 3c. LiveKit credentials (must match the LiveKit server configuration)
# Local-only values for: docker compose --profile development up
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# 3d. Optional OpenTelemetry collector
OTEL_EXPORTER_OTLP_ENDPOINT=

# Set true only when the browser reaches the application over HTTPS.
AUTH_COOKIE_SECURE=false

# 4. Frontend Client
CORS_ORIGIN=http://localhost
