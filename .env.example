# ==========================================
# CẤU HÌNH BẢO MẬT HỆ THỐNG
# Sao chép file này thành .env và điền giá trị thật
# ==========================================

# 1. Cơ sở dữ liệu (PostgreSQL)
POSTGRES_PASSWORD=your_super_secret_postgres_password_here

# 2. Redis (cache, revocation state and distributed AI rate limiting)
# Host:port only — the API container automatically appends the password below as
# "<host:port>,password=${REDIS_PASSWORD}" when it builds the connection string.
REDIS_CONNECTION_STRING=redis:6379
# Password protecting Redis (holds the JWT blacklist + distributed rate-limit state).
# Required by docker-compose. Use a strong value and do NOT include a comma.
REDIS_PASSWORD=your_super_secret_redis_password_here

# 3. JWT Security (Bảo mật API)
JWT_SECRET_KEY=your_super_secret_jwt_key_must_be_at_least_32_characters_long

# 3b. Optional LM-Kit commercial license
LMKIT_LICENSE_KEY=
# Production should set all three values below to true. They remain false in the
# local example so the infrastructure can be tested without downloading a model.
LMKIT_REQUIRE_LICENSE=false
AI_WARMUP_CHAT_MODEL=false
AI_REQUIRE_CHAT_MODEL_READY=false

# 3c. LiveKit credentials (must match the LiveKit server configuration)
# Local-only values for: docker compose --profile development up
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# 3d. Optional OpenTelemetry collector
OTEL_EXPORTER_OTLP_ENDPOINT=

# Set true only when the browser reaches the application over HTTPS.
AUTH_COOKIE_SECURE=false

# 4. Frontend Client
CORS_ORIGIN=http://localhost
