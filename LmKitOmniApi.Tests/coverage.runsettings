<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!--
    Configures the coverlet "XPlat Code Coverage" data collector (coverlet.collector,
    already referenced by this test project). CI passes it with the collect and settings
    switches; see .github/workflows/ci.yml, "Test with code coverage".

    Do NOT write those switches out here. A double hyphen is illegal inside an XML comment,
    so spelling them made this file unparseable: dotnet test refused it with "Settings file
    provided does not conform to required format", which failed the whole backend CI job
    before a single test ran.

    THRESHOLDS ARE NOT SET HERE. The coverlet COLLECTOR (as opposed to its MSBuild and console
    front ends) has no threshold option, so anything written here would be ignored in silence.
    The floor is enforced by the "Enforce coverage floor" step in .github/workflows/ci.yml,
    which reads the cobertura report this collector writes. Widening an Exclude below raises
    the measured percentage without testing anything, so change one and the other together.
  -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Do not measure the test project or third-party test infrastructure. -->
          <Exclude>[LmKitOmniApi.Tests]*,[xunit.*]*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <!-- EF Core migrations are generated scaffolding, not hand-written logic. -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
