# Shell scripts must stay LF — CRLF breaks them on Linux/WSL.
*.sh text eol=lf
# Windows batch files stay CRLF.
*.bat text eol=crlf
# Generated by unplugin-vue-components on every client build, always with LF. Without this
# pin, core.autocrlf=true reports the file as modified on every Windows checkout even when
# `git diff` is empty -- a permanent phantom change that trains people to ignore git status.
LmKitOmniClient/components.d.ts text eol=lf
